# Copy to .env (docker compose reads it automatically) and fill in real
# values before `docker compose up`.

# AES-256 key for encrypting IPTV provider credentials at rest. Generate
# with: openssl rand -base64 32
# Required — docker compose refuses to start without it.
ENCRYPTION_KEY=

# Host port the web UI is published on: http://<this-host>:WEB_PORT
WEB_PORT=8090

# Host port the API is published on directly (not just via web's /api/
# proxy) — client apps (Lao, iptv-web-player, iptv-scheduler) connect here.
# Defaults to matching the container's internal port (3300); only change
# this if 3300 is already taken on your host. If you do change it, also set
# the "Public API URL" override on the Config page (GET/PUT /config/api-url)
# — the auto-detected default won't know about a remapped port.
API_PORT=3300

# Public URL where the web UI is reachable, reported to other clients via
# GET /config/ui-url (e.g. so Lao's Settings screen can link back to it).
# Defaults to http://localhost:WEB_PORT if unset — override once this is
# reachable at a real hostname (e.g. https://iptv-recorder.example.com).
UI_URL=
